# Copy this file to server/.env and fill in the values.
# Never put real passwords or secrets in this file: it is committed to git.

# MongoDB connection string (Atlas or local)
DB=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority

# Long random string used to sign session cookies, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Gemini key for the contractor quotation analysis
GEMINI_API_KEY=

# Singpass (FAPI 2.0) + Myinfo.
# These defaults point at MockPass (`pnpm mockpass`).
SINGPASS_DISCOVERY_URL=http://localhost:5156/singpass/v3/fapi/.well-known/openid-configuration
SINGPASS_CLIENT_ID=ecohome-local
SINGPASS_REDIRECT_URI=http://localhost:5173/api/auth/singpass/callback
SINGPASS_SCOPES=openid user.identity name hdbtype housingtype regadd marital childrenbirthrecords
# SINGPASS_KEYS_FILE=keys/singpass-jwks.json
